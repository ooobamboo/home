#!/bin/sh

save_and_notify() {
    screenshot_dir="$XDG_PICTURES_DIR/shot"
    mkdir -p "$screenshot_dir"
    screenshot_file="$screenshot_dir/shot-$(date +%Y-%m-%d_%H_%M_%S).png"

    tee "$screenshot_file" | wl-copy && fyi -u low "${0##*/}" "$1"
}

shotWindow() {
    window_handle=$(swaymsg -t get_tree | jq -j '.. | select(.type?) | select(.focused).foreign_toplevel_identifier')
    [ -n "$window_handle" ] && grim -T "$window_handle" - | save_and_notify "Focused Window"
}

shotAll() {
    grim - | save_and_notify "All Outputs"
}

shotGeo() {
    region=$(slurp) && grim -g "$region" - | save_and_notify "$region"
}

shotShow() {
    grim - | imv -f -
}

shotOCR() {
    fifo_path=$(mktemp -u /tmp/ocr.XXXXXX.png)
    mkfifo "$fifo_path"

    cat "$fifo_path" | ocr | wl-copy -n &
    pipeline_pid=$!

    region=$(slurp) || { : > "$fifo_path"; rm -f "$fifo_path"; exit 1; }

    grim -g "$region" "$fifo_path"
    wait "$pipeline_pid"
    rm -f "$fifo_path"

    fyi -u low "${0##*/}" "OCR Complete"
}

case "${1:---window}" in
    --window) shotWindow ;;
    --all)    shotAll ;;
    --geo)    shotGeo ;;
    --show)   shotShow ;;
    --ocr)    shotOCR ;;
esac
