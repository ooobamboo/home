#!/bin/sh

CACHE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/chars"
EMOJI_CACHE="$CACHE_DIR/emoji"
NERD_CACHE="$CACHE_DIR/nerd"

mkdir -p "$CACHE_DIR"

[ -f "$EMOJI_CACHE" ] || {
    echo "Downloading Emoji cache..."
    curl -sfL "https://unicode.org/Public/emoji/latest/emoji-test.txt" | \
        grep -v '^#' | grep '; fully-qualified' | \
        sed -e 's/.*# //g' -e 's/ E[0-9.]* //g' > "$EMOJI_CACHE"
}

[ -f "$NERD_CACHE" ] || {
    echo "Downloading Nerd Fonts cache..."
    curl -sfL "https://raw.githubusercontent.com/ryanoasis/nerd-fonts/master/glyphnames.json" | \
        jq -r 'to_entries[] | select(.value.char != null) | "\(.value.char) \(.key)"' > "$NERD_CACHE"
}

SELECTED=$(cat "$EMOJI_CACHE" "$NERD_CACHE" | mew -i -l 20 -p "${0##*/}" | cut -d' ' -f1 | tr -d '\n')

[ -n "$SELECTED" ] && wtype "$SELECTED"
