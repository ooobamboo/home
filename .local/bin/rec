#!/bin/sh

pidof -q wf-recorder && {
	pkill -INT wf-recorder
	exit
}

record_file="${XDG_VIDEOS_DIR}/rec/rec-$(date +%Y-%m-%d_%H_%M_%S).mp4"

wf-recorder \
	-f "$record_file" \
	-g "$(head -n1)" \
	-r 60 || {
		fyi "Screen recording failed"
		exit 1
	}

printf 'file://%s' "$record_file" | wl-copy -t text/uri-list
fyi "Screen recording captured"