#!/bin/sh

mode=in
! [ "$1" = -e ] || { mode=ex; shift; }

val="$1"
case $val in [0-9]*) ;; *) printf 'usage: bl [-e] n[%][-/+]\n' >&2; exit 1 ;; esac

case $mode in
in)
    dev=/sys/class/backlight/nvidia_0
    [ -e "$dev" ] || { printf 'no backlight class\n' >&2; exit 1; }

    read -r cur < "$dev/brightness"
    read -r max < "$dev/max_brightness"

    case $val in
        *+) num=${val%+}; num=${num%%%}; cur=$(( cur + num * max / 100 )) ;;
        *-) num=${val%-}; num=${num%%%}; cur=$(( cur - num * max / 100 )) ;;
        *)  num=${val%%%}; cur=$(( num * max / 100 )) ;;
    esac

    [ "$cur" -gt "$max" ] && cur=$max
    [ "$cur" -lt 0 ] && cur=0

    printf "$cur\n" > "$dev/brightness" || { printf 'write failed\n' >&2; exit 1; }
    res=$cur
    ;;
ex)
    cache=$XDG_STATE_HOME/brightness-ddc
    read -r cur < "$cache" 2>/dev/null || cur=0

    case $val in
        *+) tgt=$(( cur + ${val%%[!0-9]*} )) ;;
        *-) tgt=$(( cur - ${val%%[!0-9]*} )) ;;
        *)  tgt=${val%%[!0-9]*} ;;
    esac

    [ "$tgt" -lt 0 ] && tgt=0
    [ "$tgt" -gt 100 ] && tgt=100

    chk=$(( 0x6E ^ 0x51 ^ 0x84 ^ 0x03 ^ 0x10 ^ 0 ^ tgt ))
    i2ctransfer -y 2 w7@0x37 0x51 0x84 0x03 0x10 0 "$tgt" "$chk" || { printf 'DDC write failed\n' >&2; exit 1; }

    printf "$tgt\n" > "$cache"
    res=$tgt
    ;;
esac

fyi -r 998 -H int:value:"$res" Brightness
