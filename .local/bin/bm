#!/bin/sh

file="${XDG_DATA_HOME}/bookmarks/address"
mkdir -p "${file%/*}" && touch "$file"

case "$1" in
    -e) footclient $EDITOR "$file" ;;
    -a)
        url=$(wl-paste | grep -E 'https?://[^ ]+' | sed 's/.*\(https\?:\/\/[^ ]\+\).*/\1/' | head -1)
        [ -z "$url" ] && { fyi -u critical "${0##*/}" "no url in clipboard"; exit 1; }

        grep -Fqe "$url" "$file" && fyi 3000 "${0##*/}" "exists: $url" \
            || { printf '%s\n' "$url" >> "$file"; fyi "${0##*/}" "added: $url"; }
        ;;
    -c)
        url=$(grep -E -v '^#|^$' "$file" | mew -i -l 10 -p "Copy Address")
        [ -n "$url" ] && { echo -n "$url" | wl-copy; fyi "${0##*/}" "copied: $url"; }
        ;;
    *)
        url=$(grep -E -v '^#|^$' "$file" | mew -i -l 10 -p "${0##*/}")
        [ -n "$url" ] && $BROWSER "$url"
        ;;
esac
