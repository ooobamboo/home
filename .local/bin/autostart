#!/bin/sh

dbus-update-activation-environment DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=dwl
wlr-randr --output DP-1 --mode 2560x1440@144Hz --pos 0,0 \
    --output eDP-1 --off
pipewire &
wlsunset -l 23.1 -L 113.2 &
wlpinyin &
wl-paste --watch cliphist store &
foot -s &
wawa fill "${XDG_PICTURES_DIR}/wal/gruvbox-wallpapers/wallpapers/photography/bush.png" &
swayidle timeout 300 'wlock' \
         timeout 600 'wlr-randr --output DP-1 --off' resume 'wlr-randr --output DP-1 --on' \
         before-sleep 'wlock' &
