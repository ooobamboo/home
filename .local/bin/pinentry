#!/bin/sh -x
# Copyright (c) 2025-2026 sewn <sewn@disroot.org>
# 
# Other pinentry-fuzzel or generic menu-pinentry
# implementations are either too complex, do too little,
# or display in a displeasing manner.
#
# Modified 2026 by aloires <aloires@tutamail.com>:
#   fuzzel replaced with wmenu; description and error are
#   folded into the prompt as wmenu has no message display.

echo 'OK Pleased to meet you'

nl='
'

# Native shell implementation to decode percent-encoded
# input as $_d, avoiding perl or unportable syntax
# such as printf '%b' or replacement substitution.
decode() {
	_d=$1 p='[0-9a-fA-F][0-9a-fA-F]'
	while :; do case "$_d" in
	(*%0A*) _d="${_d%%\%0A*}$nl${_d#*\%0A}" ;;
	(*%$p*)
		_a=${_d#*\%$p}; _o="\x${_d#*\%}";
		_d="${_d%%\%*}"$(printf "${_o%%$_a}")"$_a"
	;;
	(*) break ;;
	esac; done
}

err() {
	# Specification does not define what the point
	# of this is nor how to display an error.
	echo "ERR $$ ${*:-IPC error}"
}

menu() {
	# wmenu has no message display, so the description
	# and error are folded into the prompt.
	wmenu -i \
		${2:+$2} \
		${1:+-p "$1"}
}

while read -r input; do
	cmd="${input%%\ *}"
	msg="${DESC:+$DESC$nl}${ERROR:+Error: $ERROR$nl}"
	case $cmd in
	BYE)
		echo OK
	  exit
	  ;;
	SETTITLE|OPTION|SETKEYINFO)
		# Unimplemented
		echo OK
		;;
	SETOK|SETCANCEL|SETDESC|SETERROR|SETPROMPT)
		value="${input#*$cmd}"; value="${value#?}"
		case "$value" in
		(*%[0-9a-fA-F][0-9a-fA-F]*) decode "$value" ;;
		(*) _d="$value"
		esac
		eval "${cmd#SET}='$_d'"
		echo OK
		;;
	CONFIRM)
		case "$(printf '%s\n' "${OK-Ok}" "${CANCEL-Cancel}" |
			menu "$msg")" in
		("$OK") echo OK ;;
		("$CANCEL") err ASSUAN_Not_Confirmed ;;
		(*) err "Unknown choice" ;;
		esac
		;;
	GETPIN)
	  pin="$(
	  	:|menu "${msg}${PROMPT:-pinentry}: " -P
	  )" || { err "Cancelled"; continue; }
	  printf 'D '
	  echo "$pin"
	  echo OK
	  ;;
	*) err;
	esac
done
