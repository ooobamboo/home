#!/home/seriola/.local/src/ocr/.venv/bin/python

import sys

_engine = None

def _get_engine():
    global _engine
    if _engine is None:
        from faster_paddle import OcrEngine
        _engine = OcrEngine(model_size="medium")
    return _engine

def _merge_lines(bounds):
    items = sorted(bounds.values(),
                   key=lambda b: (b["topLeftCoord"][1], b["topLeftCoord"][0]))
    if not items:
        return ""

    lines = []
    current_line = [items[0]]
    for b in items[1:]:
        prev = current_line[-1]
        prev_cy = (prev["topLeftCoord"][1] + prev["bottomRightCoord"][1]) / 2
        cur_cy = (b["topLeftCoord"][1] + b["bottomRightCoord"][1]) / 2
        prev_h = prev["bottomRightCoord"][1] - prev["topLeftCoord"][1]
        if abs(cur_cy - prev_cy) < prev_h * 0.5:
            current_line.append(b)
        else:
            lines.append(current_line)
            current_line = [b]
    lines.append(current_line)

    return "\n".join(
        " ".join(b["text"] for b in sorted(line, key=lambda b: b["topLeftCoord"][0]))
        for line in lines
    )

def main():
    raw_data = sys.stdin.buffer.read()
    if not raw_data:
        return

    engine = _get_engine()
    result = engine.ocr(raw_data)
    bounds = result.get("bounds", {})

    if not bounds:
        text = result.get("text", "").strip()
    else:
        text = _merge_lines(bounds).strip()

    if text:
        sys.stdout.write(text + "\n")

if __name__ == "__main__":
    main()
