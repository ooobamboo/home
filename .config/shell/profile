export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

export XDG_DOWNLOAD_DIR="$HOME/Downloads"
export XDG_DOCUMENTS_DIR="$HOME/Documents"
export XDG_MUSIC_DIR="$HOME/Music"
export XDG_PICTURES_DIR="$HOME/Pictures"
export XDG_VIDEOS_DIR="$HOME/Videos"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

export EDITOR="/usr/local/bin/vim"
export PAGER="/usr/bin/less"
export BROWSER="$XDG_DATA_HOME/flatpak/exports/bin/io.github.ungoogled_software.ungoogled_chromium"

# theme
export GTK_THEME="Adwaita:dark"
export QT_QPA_PLATFORMTHEME="xdgdesktopportal"

# ime
export QT_IM_MODULES="wayland;fcitx;ibus"
export XMODIFIERS=@im="fcitx"
export SDL_IM_MODULE="fcitx"

# config
export WGETRC="$XDG_CONFIG_HOME/wget/wgetrc"
export GIT_CONFIG_GLOBAL="$XDG_CONFIG_HOME/git/config"
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export GNUPGHOME="$XDG_CONFIG_HOME/gnupg"
export INPUTRC="$XDG_CONFIG_HOME/readline/inputrc"
export _JAVA_OPTIONS=-Djava.util.prefs.userRoot="$XDG_CONFIG_HOME/java"

# cache
export CUDA_CACHE_PATH="$XDG_CACHE_HOME/nv"
export GOMODCACHE="$XDG_CACHE_HOME/go/mod"

# state
export PYTHON_HISTORY="$XDG_STATE_HOME/python_history"
export LESSHISTFILE="$XDG_STATE_HOME/less/history"
export SQLITE_HISTORY="$XDG_STATE_HOME/sqlite_history"
export HISTFILE="$XDG_STATE_HOME/history"

# data
export W3M_DIR="$XDG_DATA_HOME/w3m"
export GOPATH="$XDG_DATA_HOME/go"
export GRADLE_USER_HOME="$XDG_DATA_HOME/gradle"
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export PASSWORD_STORE_DIR="$XDG_DATA_HOME/password"
export ZVM_PATH="$XDG_DATA_HOME/zvm"
export MANPATH="$XDG_DATA_HOME/man:/usr/share/man:"
export NODE_REPL_HISTORY="$XDG_DATA_HOME/node_repl_history"

# mirrors
export RUSTUP_DIST_SERVER=https://mirrors.ustc.edu.cn/rust-static
export RUSTUP_UPDATE_ROOT=https://mirrors.ustc.edu.cn/rust-static/rustup
export GOPROXY="https://mirrors.aliyun.com/goproxy"
export PIP_INDEX_URL="https://mirrors.ustc.edu.cn/pypi/simple"

# wayland
export _JAVA_AWT_WM_NONREPARENTING=1

# android
export ANDROID_USER_HOME="$XDG_DATA_HOME/android"
export ANDROID_HOME="$XDG_DATA_HOME/android"
export ANDROID_SDK_ROOT="$XDG_DATA_HOME/android"

PATH="$HOME/.local/bin:\
$XDG_DATA_HOME/flatpak/exports/bin:\
$CARGO_HOME/bin:\
/usr/local/go/bin:\
$GOPATH/bin:\
$XDG_DATA_HOME/zvm/bin:\
$XDG_DATA_HOME/npm/bin:\
$ANDROID_HOME/platform-tools:\
$XDG_DATA_HOME/vim-lsp-settings/servers/clangd/bin:\
$(find "$XDG_DATA_HOME/vim-lsp-settings/servers" -mindepth 1 -maxdepth 1 -type d | paste -sd ':'):\
$PATH"
export PATH

export PATH="$PATH:$(find ${XDG_DATA_HOME:-$HOME/.local/share}/vim-lsp-settings/servers -mindepth 1 -maxdepth 1 -type d 2>/dev/null | paste -sd ':')"

if [ -z "$WAYLAND_DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then
    exec dbus-run-session ssh-agent sh -c 'slstatus -s | dwl -s autostart'
    #exec dbus-run-session ssh-agent sh -c 'sway'
fi
